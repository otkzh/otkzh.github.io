---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'otkzh.github.io',
  description = '太田一穂のプロフィール、メモ、ウェブツールを掲載しています。',
} = Astro.props

const documentTitle =
  title === 'otkzh.github.io' ? title : `${title} | otkzh.github.io`
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="メインナビゲーション">
        <a class="brand" href="/">otkzh.github.io</a>
        <a href="/memo/">Memo</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #172033;
    background: #f6f8fb;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    line-height: 1.7;
  }

  a {
    color: #0757a6;
    text-underline-offset: 0.16em;
  }

  a:hover {
    color: #003b73;
  }

  .site-header {
    border-bottom: 1px solid #dfe5ee;
    background: rgba(255, 255, 255, 0.92);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100% - 2rem, 880px);
    min-height: 3.75rem;
    margin-inline: auto;
  }

  .site-header .brand {
    margin-right: auto;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  main {
    width: min(100% - 2rem, 880px);
    margin: 3rem auto 5rem;
  }

  .content {
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid #e3e8ef;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1rem 2.5rem rgba(25, 45, 80, 0.06);
  }

  .content > :first-child {
    margin-top: 0;
  }

  .content > :last-child {
    margin-bottom: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.3;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  h2 {
    margin-top: 2.25rem;
  }

  pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.5rem;
    background: #172033;
    color: #f7f9fc;
  }

  @media (max-width: 560px) {
    main {
      margin-top: 1.5rem;
    }
  }
</style>

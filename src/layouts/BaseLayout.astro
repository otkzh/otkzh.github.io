---
interface Props {
  title?: string
  description?: string
  pageClass?: string
  themeColor?: string
}

const {
  title = 'otkzh.github.io',
  description = '太田一穂のプロフィール、メモ、ウェブツールを掲載しています。',
  pageClass,
  themeColor = '#ffffff',
} = Astro.props

const documentTitle =
  title === 'otkzh.github.io' ? title : `${title} | otkzh.github.io`
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700;800&amp;family=Space+Grotesk:wght@400;500;600;700&amp;family=Zen+Kaku+Gothic+New:wght@400;500;700;900&amp;display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{documentTitle}</title>
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <nav aria-label="メインナビゲーション">
        <a class="brand" href="/">otkzh.github.io</a>
        <a href="/memo/">Memo</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-size: 18px;
    font-family:
      'Zen Kaku Gothic New',
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    color: #222;
    background: #f6f8fb;
    font-synthesis: none;
  }

  html {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    line-height: 1.8;
  }

  a {
    color: #0757a6;
    text-underline-offset: 0.16em;
  }

  a:hover {
    color: #003b73;
  }

  .site-header {
    border-bottom: 1px solid #dfe5ee;
    background: rgba(255, 255, 255, 0.92);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100% - 2rem, 880px);
    min-height: 3.75rem;
    margin-inline: auto;
  }

  .site-header .brand {
    margin-right: auto;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header nav a {
    font-size: 1rem;
  }

  main {
    width: min(100% - 2rem, 880px);
    margin: 3rem auto 5rem;
  }

  .content {
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid #e3e8ef;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1rem 2.5rem rgba(25, 45, 80, 0.06);
  }

  .content > :first-child {
    margin-top: 0;
  }

  .content > :last-child {
    margin-bottom: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.3;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  h2 {
    margin-top: 2.25rem;
  }

  pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.5rem;
    background: #172033;
    color: #f7f9fc;
  }

  @media (max-width: 560px) {
    main {
      margin-top: 1.5rem;
    }
  }
</style>

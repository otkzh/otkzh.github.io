---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  kind?: 'index' | 'article'
}

const {
  title,
  description = '地図、データ、Webについての太田一穂のメモ。',
  kind = 'article',
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  pageClass={`memo-page memo-${kind}`}
  themeColor="#f4f3ef"
>
  <div class="memo-page-shell">
    <header class="memo-masthead">
      <a class="memo-monogram" href="/" aria-label="トップページへ">KO</a>
      <div>
        <span>OTKZH.GITHUB.IO</span>
        <strong>NOTES / MEMO</strong>
      </div>
      <a class="memo-index-link" href="/memo/">INDEX</a>
    </header>

    <slot />

    <footer class="memo-footer">
      <span>太田 一穂 / Kazuho OHTA</span>
      <a href="/">DIGITAL CARD ↗</a>
      <span>© 2026</span>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  body.memo-page {
    --blue: #365cff;
    --ink: #111318;
    --paper: #f4f3ef;
    --line: rgba(17, 19, 24, 0.2);
    background:
      linear-gradient(rgba(17, 19, 24, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 24, 0.035) 1px, transparent 1px),
      var(--paper);
    background-size: 24px 24px;
    color: var(--ink);
  }

  body.memo-page .site-header {
    display: none;
  }

  body.memo-page main {
    width: min(100% - 3rem, 1180px);
    margin: 2.5rem auto;
  }

  .memo-page-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 30px 70px rgba(31, 38, 58, 0.12);
  }

  .memo-page-shell::before,
  .memo-page-shell::after {
    position: absolute;
    z-index: 20;
    width: 18px;
    height: 18px;
    content: '';
    pointer-events: none;
  }

  .memo-page-shell::before {
    top: 10px;
    left: 10px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .memo-page-shell::after {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .memo-masthead {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 5.4rem;
    padding: 1rem clamp(1.25rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ink);
    font-family: "Space Grotesk", sans-serif;
  }

  .memo-monogram {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid var(--ink);
    background: var(--blue);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .memo-monogram:hover {
    color: #fff;
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .memo-masthead > div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .memo-masthead span,
  .memo-index-link {
    color: #696d76;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .memo-masthead strong {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .memo-index-link {
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 0.35em;
  }

  .memo-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 1.4rem clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--ink);
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .memo-footer a {
    color: var(--ink);
    font-weight: 700;
  }

  .memo-footer span:last-child {
    text-align: right;
  }

  @media (max-width: 720px) {
    body.memo-page {
      height: 100dvh;
      overflow: hidden;
      background:
        linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        #191b22;
      background-size: 24px 24px;
    }

    body.memo-page main {
      width: min(100%, 496px);
      height: 100dvh;
      margin: 0;
      margin-inline: auto;
      padding: max(0.5rem, env(safe-area-inset-top)) 0.5rem max(0.5rem, env(safe-area-inset-bottom));
    }

    .memo-page-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      border-radius: 10px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
    }

    .memo-masthead {
      flex: none;
      min-height: 4.7rem;
      padding-inline: 1rem;
    }

    .memo-monogram {
      width: 2.5rem;
      height: 2.5rem;
    }

    .memo-footer {
      flex: none;
      grid-template-columns: 1fr auto;
      padding: 1.25rem 1rem;
    }

    .memo-footer span:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .memo-monogram {
      transition: none;
    }
  }
</style>

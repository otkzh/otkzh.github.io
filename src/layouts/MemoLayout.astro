---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  kind?: 'index' | 'article'
}

const {
  title,
  description = '地図、データ、Webについての太田一穂のメモ。',
  kind = 'article',
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  pageClass={`memo-page memo-${kind}`}
  themeColor="#f4f3ef"
>
  <div class="memo-page-shell">
    <header class="memo-masthead">
      <a class="memo-site-title" href="/" aria-label="トップページへ">
        <span>OTKZH.GITHUB.IO</span>
        <strong>NOTES / MEMO</strong>
      </a>
      <a class="memo-index-link" href="/memo/">INDEX</a>
    </header>

    <slot />

    <footer class="memo-footer">
      <span>太田 一穂 / Kazuho OHTA</span>
      <a href="/">DIGITAL CARD ↗</a>
      <span>© 2026</span>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  body.memo-page {
    --blue: #365cff;
    --ink: #111318;
    --paper: #f4f3ef;
    --line: rgba(17, 19, 24, 0.2);
    background:
      linear-gradient(rgba(17, 19, 24, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 24, 0.035) 1px, transparent 1px),
      var(--paper);
    background-size: 24px 24px;
    color: var(--ink);
  }

  body.memo-page .site-header {
    display: none;
  }

  body.memo-page main {
    width: min(100% - 3rem, 1180px);
    margin: 2.5rem auto;
  }

  .memo-page-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 30px 70px rgba(31, 38, 58, 0.12);
  }

  .memo-page-shell::before,
  .memo-page-shell::after {
    position: absolute;
    z-index: 20;
    width: 18px;
    height: 18px;
    content: '';
    pointer-events: none;
  }

  .memo-page-shell::before {
    top: 10px;
    left: 10px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .memo-page-shell::after {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .memo-masthead {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 5.4rem;
    padding: 1rem clamp(1.25rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ink);
    font-family: 'Space Grotesk', sans-serif;
  }

  .memo-site-title {
    display: flex;
    flex-direction: column;
    width: fit-content;
    color: var(--ink);
    line-height: 1.25;
    text-decoration: none;
  }

  .memo-masthead span,
  .memo-index-link {
    color: #333;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .memo-masthead strong {
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
  }

  .memo-index-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    transition:
      color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .memo-index-link:hover {
    background: var(--ink);
    color: #fff;
    transform: translateY(-2px);
  }

  .memo-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 1.4rem clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--ink);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .memo-footer a {
    color: var(--ink);
    font-weight: 700;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.28em;
  }

  .memo-footer span:last-child {
    text-align: right;
  }

  @media (min-width: 0) {
    body.memo-page {
      height: 100dvh;
      overflow: hidden;
      background:
        linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        #191b22;
      background-size: 24px 24px;
    }

    body.memo-page main {
      width: min(100%, 496px);
      height: 100dvh;
      margin: 0;
      margin-inline: auto;
      padding: max(0.5rem, env(safe-area-inset-top))
        max(0.5rem, env(safe-area-inset-right))
        max(0.5rem, env(safe-area-inset-bottom))
        max(0.5rem, env(safe-area-inset-left));
    }

    .memo-page-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      border-radius: 10px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
    }

    .memo-masthead {
      flex: none;
      min-height: 4.7rem;
      padding-inline: 1rem;
    }

    .memo-footer {
      flex: none;
      grid-template-columns: 1fr auto;
      padding: 1.25rem 1rem;
    }

    .memo-footer span:first-child {
      display: none;
    }
  }

  @media (orientation: landscape) and (max-height: 560px),
    (min-width: 721px) {
    body.memo-page {
      font-family: 'Shippori Mincho', serif;
    }

    body.memo-page main {
      width: min(100%, 1180px);
      max-width: none;
      padding: max(0.4rem, env(safe-area-inset-top)) 0.5rem
        max(0.4rem, env(safe-area-inset-bottom));
    }

    .memo-page-shell {
      border-radius: 8px;
    }

    .memo-masthead {
      min-height: 3.8rem;
      padding: 0.55rem clamp(1.2rem, 3vw, 2rem);
    }

    .memo-masthead strong {
      font-size: 0.72rem;
    }

    .memo-footer {
      padding: 0.7rem clamp(1.2rem, 3vw, 2rem);
      font-size: clamp(0.58rem, 1vw, 0.72rem);
    }
  }

  @media (min-width: 721px) and (min-height: 561px) {
    body.memo-page {
      display: grid;
      min-height: 100dvh;
      place-items: center;
    }

    body.memo-page main {
      width: min(
        calc(100vw - clamp(4rem, 10vw, 8rem)),
        1180px,
        calc((100dvh - clamp(4rem, 10vw, 8rem)) * 1.685)
      );
      height: auto;
      padding: 0;
      aspect-ratio: 91 / 54;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .memo-index-link {
      transition: none;
    }
  }
</style>

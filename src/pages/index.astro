<script>
  const card = document.querySelector<HTMLElement>('#business-card')
  const pages = Array.from(
    document.querySelectorAll<HTMLElement>('[data-card-page]'),
  )
  const indicators = Array.from(
    document.querySelectorAll<HTMLElement>('.card-indicators > span'),
  )
  const pageNames = ['profile', 'activity', 'memo'] as const
  const requestedPage = pageNames.indexOf(
    new URLSearchParams(window.location.search).get(
      'card',
    ) as (typeof pageNames)[number],
  )
  let currentPage = requestedPage >= 0 ? requestedPage : 0
  let isTurning = false
  let pointerStartX = 0
  let pointerStartY = 0
  let deviceTiltRequested = false
  let orientationBaseline: { beta: number; gamma: number } | null = null

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value))

  const handleDeviceOrientation = (event: DeviceOrientationEvent) => {
    if (!card || event.beta === null || event.gamma === null) return

    orientationBaseline ??= { beta: event.beta, gamma: event.gamma }
    const beta = clamp(event.beta - orientationBaseline.beta, -28, 28)
    const gamma = clamp(event.gamma - orientationBaseline.gamma, -32, 32)

    card.style.setProperty('--tilt-x', `${beta * -0.12}deg`)
    card.style.setProperty('--tilt-y', `${gamma * 0.15}deg`)
    card.style.setProperty('--light-x', `${clamp(50 + gamma * 1.15, 18, 82)}%`)
    card.style.setProperty('--light-y', `${clamp(50 + beta * 0.9, 20, 80)}%`)
    card.dataset.lean = gamma > 10 ? 'right' : gamma < -10 ? 'left' : 'center'
    card.dataset.posture = Math.abs(event.gamma) > 45 ? 'sideways' : 'upright'
  }

  const enableDeviceTilt = async () => {
    if (deviceTiltRequested || window.matchMedia('(prefers-reduced-motion: reduce)').matches)
      return
    if (!('DeviceOrientationEvent' in window)) return

    deviceTiltRequested = true
    const orientationEvent = DeviceOrientationEvent as typeof DeviceOrientationEvent & {
      requestPermission?: () => Promise<'granted' | 'denied'>
    }

    if (orientationEvent.requestPermission) {
      try {
        if ((await orientationEvent.requestPermission()) !== 'granted') return
      } catch {
        return
      }
    }

    window.addEventListener('deviceorientation', handleDeviceOrientation, {
      passive: true,
    })
  }

  const setLinkAccess = (page: HTMLElement, active: boolean) => {
    page.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.tabIndex = active ? 0 : -1
    })
  }

  const syncCardUrl = () => {
    const url = new URL(window.location.href)
    if (currentPage === 0) url.searchParams.delete('card')
    else url.searchParams.set('card', pageNames[currentPage])
    window.history.replaceState(
      {},
      '',
      `${url.pathname}${url.search}${url.hash}`,
    )
  }

  const turnCard = (direction: 1 | -1) => {
    if (!card || isTurning || pages.length === 0) return

    isTurning = true
    card.dataset.turnDirection = direction === 1 ? 'next' : 'previous'
    card.classList.add('is-turning')
    const previousPage = currentPage
    currentPage = (currentPage + direction + pages.length) % pages.length
    card.dataset.page = pageNames[currentPage]
    const outgoing = pages[previousPage]
    const incoming = pages[currentPage]

    outgoing.classList.remove('is-active')
    outgoing.classList.add(
      direction === 1 ? 'is-exiting-next' : 'is-exiting-previous',
    )
    outgoing.setAttribute('aria-hidden', 'true')
    setLinkAccess(outgoing, false)

    incoming.classList.add(
      'is-preparing',
      direction === 1 ? 'from-next' : 'from-previous',
    )
    incoming.setAttribute('aria-hidden', 'false')
    setLinkAccess(incoming, true)

    indicators.forEach((indicator, index) => {
      indicator.classList.toggle('is-current', index === currentPage)
    })
    syncCardUrl()

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        incoming.classList.remove('is-preparing', 'from-next', 'from-previous')
        incoming.classList.add('is-active')
      })
    })

    window.setTimeout(() => {
      outgoing.classList.remove('is-exiting-next', 'is-exiting-previous')
      card.classList.remove('is-turning')
      isTurning = false
    }, 680)
  }

  pages.forEach((page, index) => {
    const isCurrent = index === currentPage
    page.classList.toggle('is-active', isCurrent)
    page.setAttribute('aria-hidden', String(!isCurrent))
    setLinkAccess(page, isCurrent)
  })
  indicators.forEach((indicator, index) => {
    indicator.classList.toggle('is-current', index === currentPage)
  })
  if (card) card.dataset.page = pageNames[currentPage]

  card?.addEventListener('pointerdown', (event) => {
    pointerStartX = event.clientX
    pointerStartY = event.clientY
    if (event.pointerType !== 'mouse') void enableDeviceTilt()
  })

  card?.addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse') return
    const bounds = card.getBoundingClientRect()
    const x = (event.clientX - bounds.left) / bounds.width - 0.5
    const y = (event.clientY - bounds.top) / bounds.height - 0.5
    card.style.setProperty('--tilt-x', `${y * -4}deg`)
    card.style.setProperty('--tilt-y', `${x * 5}deg`)
    card.style.setProperty('--light-x', `${(x + 0.5) * 100}%`)
    card.style.setProperty('--light-y', `${(y + 0.5) * 100}%`)
    card.dataset.lean = x > 0.18 ? 'right' : x < -0.18 ? 'left' : 'center'
  })

  card?.addEventListener('pointerleave', () => {
    card.style.setProperty('--tilt-x', '0deg')
    card.style.setProperty('--tilt-y', '0deg')
    card.dataset.lean = 'center'
  })

  card?.addEventListener('pointerup', (event) => {
    if ((event.target as HTMLElement).closest('a')) return
    const deltaX = event.clientX - pointerStartX
    const deltaY = event.clientY - pointerStartY
    const isSwipe = Math.abs(deltaX) > 36 && Math.abs(deltaX) > Math.abs(deltaY)
    const isTap = Math.abs(deltaX) < 8 && Math.abs(deltaY) < 8

    if (isSwipe) turnCard(deltaX < 0 ? 1 : -1)
    else if (isTap) {
      const bounds = card.getBoundingClientRect()
      turnCard(event.clientX < bounds.left + bounds.width / 2 ? -1 : 1)
    }
  })

  card?.addEventListener('keydown', (event) => {
    if ((event.target as HTMLElement).closest('a')) return
    if (
      event.key === 'Enter' ||
      event.key === ' ' ||
      event.key === 'ArrowRight'
    ) {
      event.preventDefault()
      turnCard(1)
    } else if (event.key === 'ArrowLeft') {
      event.preventDefault()
      turnCard(-1)
    }
  })

  if ('IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-ready')
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) entry.target.classList.add('is-visible')
        }
      },
      { threshold: 0.16 },
    )

    document
      .querySelectorAll('.reveal')
      .forEach((element) => observer.observe(element))
  }
</script>

<style is:global>
  body.home {
    --blue: #365cff;
    --ink: #111318;
    --paper: #f4f3ef;
    --line: rgba(17, 19, 24, 0.2);
    background:
      radial-gradient(
        circle at 78% 5%,
        rgba(54, 92, 255, 0.1),
        transparent 26rem
      ),
      var(--paper);
    color: var(--ink);
  }

  .micro-row,
  .card-face-header,
  .roman-name,
  .accent-label,
  .section-index,
  .card-navigation,
  .memo-kicker {
    font-family: 'Space Grotesk', sans-serif;
  }

  body.home .site-header {
    background: rgba(244, 243, 239, 0.88);
    border-color: var(--line);
    backdrop-filter: blur(16px);
  }

  body.home .site-header nav {
    width: min(100% - 3rem, 1180px);
  }

  body.home .site-header a {
    color: var(--ink);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  body.home main {
    width: min(100% - 3rem, 1180px);
    margin: 2.5rem auto 0;
  }

  .mobile-card-shell {
    display: none;
  }

  .desktop-home {
    display: grid;
    gap: 7rem;
  }

  .hero-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(310px, 0.75fr);
    min-height: 650px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 30px 70px rgba(31, 38, 58, 0.12);
  }

  .hero-card::before,
  .hero-card::after {
    position: absolute;
    z-index: 2;
    width: 28px;
    height: 28px;
    content: '';
  }

  .hero-card::before {
    top: 18px;
    left: 18px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .hero-card::after {
    right: 18px;
    bottom: 18px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(3rem, 6vw, 5.5rem);
  }

  .micro-row,
  .card-face-header {
    display: flex;
    justify-content: space-between;
    color: #4d5260;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .micro-row span:first-child,
  .accent-label,
  .card-label {
    color: var(--blue);
  }

  .identity {
    margin-top: 4.5rem;
  }

  .identity h1 {
    margin: 0;
    font-size: clamp(3.8rem, 7vw, 6.7rem);
    font-weight: 750;
    letter-spacing: -0.08em;
    line-height: 0.98;
  }

  .roman-name {
    margin: 0.8rem 0 0;
    color: #333;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .hero-statement {
    margin: 4.2rem 0 0;
    font-size: clamp(1.7rem, 3.1vw, 2.75rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  .hero-tagline {
    margin: 1rem 0 0;
    color: #333;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: auto;
    padding-top: 3rem;
  }

  .primary-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-width: 235px;
    padding: 0.8rem 0.85rem 0.8rem 1.1rem;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .primary-action:hover {
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(54, 92, 255, 0.25);
  }

  .primary-action span {
    display: grid;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    place-items: center;
    background: #fff;
    color: var(--blue);
    transition: transform 180ms ease;
  }

  .primary-action:hover span {
    transform: rotate(45deg);
  }

  .text-action {
    position: relative;
    display: inline-flex;
    padding: 0.45rem 0;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .text-action::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--blue);
    content: '';
    transform: scaleX(0.25);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .text-action:hover {
    color: var(--ink);
  }

  .text-action:hover::after {
    transform: scaleX(1);
  }

  .hero-detail {
    display: flex;
    flex-direction: column;
    padding: clamp(2.5rem, 5vw, 4rem);
    border-left: 1px solid var(--line);
    background:
      linear-gradient(rgba(54, 92, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(54, 92, 255, 0.08) 1px, transparent 1px),
      #f6f7fb;
    background-size: 28px 28px;
  }

  .detail-index {
    margin: 0;
    color: var(--blue);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .detail-lead {
    margin: clamp(2.5rem, 7vw, 5.5rem) 0 2rem;
    color: var(--blue);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 3.8vw, 3.7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.12;
  }

  .hero-detail dl {
    margin: auto 0 0;
  }

  .hero-detail dl > div {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .hero-detail dt,
  .section-index {
    color: var(--blue);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .hero-detail dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .about-section,
  .activity-section {
    display: grid;
    grid-template-columns: 130px minmax(260px, 0.8fr) minmax(360px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--ink);
  }

  .accent-label {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .about-heading h2,
  .activity-heading h2,
  .koza-title h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.7rem);
    letter-spacing: -0.06em;
    line-height: 1.08;
  }

  .about-copy {
    align-self: end;
  }

  .about-copy > p {
    max-width: 38rem;
    margin: 0 0 1.2rem;
    font-size: clamp(1rem, 1.8vw, 1.24rem);
  }

  .organization-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .organization-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--ink);
    background: #fff;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--blue);
    transition:
      color 180ms ease,
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .organization-links a:hover {
    background: var(--ink);
    color: #fff;
    box-shadow: 1px 1px 0 var(--blue);
    transform: translate(3px, 3px);
  }

  .activity-section {
    grid-template-columns: 130px minmax(260px, 0.8fr) minmax(400px, 1.1fr);
  }

  .activity-list {
    display: grid;
  }

  .activity-list article {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 1.25rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .activity-list article:last-child {
    border-bottom: 1px solid var(--line);
  }

  .activity-list article > span {
    color: var(--blue);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .activity-list h3 {
    margin: 0;
    font-size: 1rem;
  }

  .activity-list p {
    margin: 0.35rem 0 0;
    color: #333;
    font-size: 0.9375rem;
  }

  .koza-section {
    display: grid;
    grid-template-columns: 1.1fr 0.75fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(2.5rem, 6vw, 5rem);
    background: var(--blue);
    color: #fff;
  }

  .koza-title .accent-label {
    color: rgba(255, 255, 255, 0.65);
  }

  .koza-title h2 {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
  }

  .koza-name strong {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    line-height: 1.35;
  }

  .koza-section > p {
    margin: 0;
    font-size: 1rem;
  }

  .home-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--ink);
    font-size: 0.875rem;
  }

  .home-footer a {
    color: var(--ink);
    font-weight: 700;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
  }

  .home-footer span:last-child {
    text-align: right;
  }

  .reveal {
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .reveal-ready .reveal {
    opacity: 0;
    transform: translateY(24px);
  }

  .reveal-ready .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) and (min-width: 721px) {
    .hero-card {
      grid-template-columns: 1fr 300px;
    }

    .about-section,
    .activity-section {
      grid-template-columns: 90px 1fr;
    }

    .about-copy,
    .activity-list {
      grid-column: 2;
    }

    .koza-section {
      grid-template-columns: 1fr 1fr;
    }

    .koza-section > p {
      grid-column: 2;
    }
  }

  /* The three-page card is the canonical experience on every device. */
  @media (min-width: 0) {
    body.home {
      height: 100dvh;
      overflow: hidden;
      background:
        linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        #191b22;
      background-size: 24px 24px;
    }

    body.home .site-header {
      display: none;
    }

    body.home main {
      width: 100%;
      height: 100dvh;
      margin: 0;
    }

    .desktop-home {
      display: none;
    }

    .mobile-card-shell {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100dvh;
      padding: max(0.5rem, env(safe-area-inset-top))
        max(0.5rem, env(safe-area-inset-right))
        max(0.5rem, env(safe-area-inset-bottom))
        max(0.5rem, env(safe-area-inset-left));
    }

    .card-scene {
      width: min(100%, 480px);
      height: 100%;
      perspective: 1800px;
    }

    .business-card {
      --tilt-x: 0deg;
      --tilt-y: 0deg;
      --light-x: 50%;
      --light-y: 50%;
      width: 100%;
      height: 100%;
      outline: none;
      transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
      transform-style: preserve-3d;
      transition: transform 180ms ease;
      cursor: grab;
      touch-action: pan-y;
    }

    .business-card:active {
      cursor: grabbing;
    }

    .business-card:focus-visible {
      outline: 3px solid var(--blue);
      outline-offset: 5px;
    }

    .card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
    }

    .card-face {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: clamp(1.15rem, 5.5vw, 2rem) clamp(1.15rem, 6vw, 2.2rem)
        clamp(5rem, 20vw, 5.8rem);
      border: 1px solid rgba(17, 19, 24, 0.18);
      border-radius: 10px;
      background:
        radial-gradient(
          circle at var(--light-x) var(--light-y),
          rgba(255, 255, 255, 0.8),
          transparent 35%
        ),
        #fff;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
      backface-visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: rotateY(180deg);
      transform-origin: center;
      transition:
        transform 660ms cubic-bezier(0.2, 0.72, 0.15, 1),
        opacity 280ms ease;
      z-index: 0;
    }

    .card-face-header {
      gap: 0.75rem;
      font-size: clamp(0.6rem, 2.5vw, 0.7rem);
      letter-spacing: 0.12em;
      white-space: nowrap;
    }

    .card-face.is-active {
      opacity: 1;
      pointer-events: auto;
      transform: rotateY(0);
      z-index: 2;
    }

    .card-face.is-exiting-next {
      opacity: 0;
      transform: translateX(-7%) rotateY(-118deg) scale(0.985);
      transform-origin: left center;
      z-index: 3;
    }

    .card-face.is-exiting-previous {
      opacity: 0;
      transform: translateX(7%) rotateY(118deg) scale(0.985);
      transform-origin: right center;
      z-index: 3;
    }

    .card-face.is-preparing {
      transition: none;
    }

    .card-face.is-preparing.from-next {
      transform: translateX(7%) rotateY(118deg) scale(0.985);
      transform-origin: right center;
    }

    .card-face.is-preparing.from-previous {
      transform: translateX(-7%) rotateY(-118deg) scale(0.985);
      transform-origin: left center;
    }

    .business-card[data-lean='left'] .card-face.is-active {
      border-left: 3px solid var(--blue);
      box-shadow: -12px 24px 60px rgba(0, 0, 0, 0.34);
    }

    .business-card[data-lean='right'] .card-face.is-active {
      border-right: 3px solid var(--blue);
      box-shadow: 12px 24px 60px rgba(0, 0, 0, 0.34);
    }

    .business-card[data-posture='sideways'] .card-face {
      border-radius: 6px;
    }

    .business-card[data-posture='sideways'] .card-face-header {
      color: var(--blue);
      letter-spacing: 0.18em;
    }

    .card-face::before,
    .card-face::after {
      position: absolute;
      width: 16px;
      height: 16px;
      content: '';
      pointer-events: none;
    }

    .card-face::before {
      top: 10px;
      left: 10px;
      border-top: 1px solid var(--ink);
      border-left: 1px solid var(--ink);
    }

    .card-face::after {
      right: 10px;
      bottom: 10px;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }

    .mobile-identity {
      margin-top: clamp(2.2rem, 10vh, 5rem);
    }

    .mobile-identity h1 {
      margin: 0;
      font-size: clamp(2.8rem, 14vw, 4.8rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      white-space: nowrap;
    }

    .mobile-identity p {
      margin: 0.85rem 0 0;
      color: #333;
      font-size: clamp(0.9375rem, 3.2vw, 1rem);
      letter-spacing: 0.06em;
    }

    .mobile-statement {
      margin-top: auto;
    }

    .mobile-statement p {
      margin: 0;
      font-size: clamp(1.18rem, 5.7vw, 1.72rem);
      font-weight: 900;
      letter-spacing: -0.045em;
      line-height: 1.36;
    }

    .mobile-statement > span {
      display: block;
      margin-top: 0.8rem;
      color: #333;
      font-size: clamp(0.9375rem, 3.2vw, 1rem);
      font-weight: 500;
      line-height: 1.5;
    }

    .mobile-role {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      margin-top: clamp(1.2rem, 5vh, 2.8rem);
      padding-top: 0.7rem;
      border-top: 1px solid var(--ink);
      font-size: clamp(0.9375rem, 2.45vw, 1rem);
      line-height: 1.5;
    }

    .mobile-role strong {
      font-weight: 700;
    }

    .memo-all-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0;
      padding: 0.72rem 0.85rem;
      border: 1px solid var(--blue);
      background: linear-gradient(135deg, var(--blue), #2447df);
      color: #fff;
      font-size: clamp(0.875rem, 2.5vw, 1rem);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      box-shadow: 4px 4px 0 rgba(17, 19, 24, 0.16);
      transition:
        box-shadow 180ms ease,
        transform 180ms ease;
    }

    .memo-all-link:hover {
      color: #fff;
      box-shadow: 1px 1px 0 rgba(17, 19, 24, 0.16);
      transform: translate(3px, 3px);
    }

    .contact-links {
      display: flex;
      gap: 0.35rem;
      align-items: stretch;
      justify-self: center;
      pointer-events: auto;
    }

    .contact-links a {
      display: grid;
      width: clamp(2.35rem, 10vw, 2.7rem);
      aspect-ratio: 1;
      place-items: center;
      border: 1px solid var(--ink);
      border-radius: 50%;
      color: var(--ink);
      text-decoration: none;
      transition:
        border-color 160ms ease,
        color 160ms ease,
        background 160ms ease,
        transform 160ms ease;
    }

    .contact-links a:hover,
    .contact-links a:focus-visible {
      border-color: var(--blue);
      background: var(--blue);
      color: #fff;
      transform: translateY(-2px);
    }

    .contact-links svg {
      width: 1.1rem;
      height: 1.1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .contact-links a:nth-child(2) svg {
      fill: currentColor;
      stroke: none;
    }

    .contact-links a span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .back-header {
      padding-bottom: 0.65rem;
      border-bottom: 2px solid var(--blue);
    }

    .card-activity {
      overflow-y: auto;
      scrollbar-width: none;
    }

    .card-activity::-webkit-scrollbar {
      display: none;
    }

    .activity-overview {
      margin-top: clamp(1.2rem, 4.5vh, 2.8rem);
    }

    .activity-kicker {
      margin: 0 0 0.25rem;
      color: var(--blue);
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(0.9375rem, 2.2vw, 1rem);
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .activity-overview h2 {
      margin: 0;
      font-size: clamp(3rem, 15vw, 5rem);
      font-weight: 900;
      letter-spacing: -0.06em;
      line-height: 1;
    }

    .activity-overview > p:last-child {
      max-width: 26rem;
      margin: 0.6rem 0 0;
      font-size: clamp(0.9375rem, 2.85vw, 1rem);
      font-weight: 500;
      line-height: 1.6;
    }

    .activity-groups {
      display: grid;
      margin-top: clamp(1.1rem, 3.5vh, 2rem);
      border-bottom: 1px solid var(--line);
    }

    .activity-group {
      padding: clamp(0.65rem, 2.4vh, 1.05rem) 0;
      border-top: 1px solid var(--line);
    }

    .activity-group header {
      display: grid;
      grid-template-columns: 1.65rem 1fr;
      gap: 0.35rem;
      align-items: baseline;
    }

    .activity-group header span {
      color: var(--blue);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.9375rem;
      font-weight: 700;
    }

    .activity-group h3 {
      margin: 0;
      font-size: clamp(1rem, 3.55vw, 1.15rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.35;
    }

    .activity-group > p {
      margin: 0.35rem 0 0 2rem;
      color: #333;
      font-size: clamp(0.9375rem, 2.35vw, 1rem);
      line-height: 1.8;
    }

    .activity-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin: 0.42rem 0 0 2rem;
    }

    .activity-links a {
      display: inline-flex;
      align-items: center;
      padding: 0.32rem 0.58rem;
      border: 1px solid rgba(54, 92, 255, 0.45);
      border-radius: 999px;
      background: rgba(54, 92, 255, 0.07);
      color: var(--blue);
      font-size: clamp(1rem, 2.25vw, 1.0625rem);
      font-weight: 700;
      line-height: 1.45;
      text-decoration: none;
      transition:
        color 160ms ease,
        background 160ms ease,
        transform 160ms ease;
    }

    .activity-links a:hover {
      background: var(--blue);
      color: #fff;
      transform: translateY(-2px);
    }

    .card-memo {
      background:
        linear-gradient(rgba(54, 92, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(54, 92, 255, 0.07) 1px, transparent 1px),
        radial-gradient(
          circle at var(--light-x) var(--light-y),
          rgba(255, 255, 255, 0.9),
          transparent 34%
        ),
        #f7f8fc;
      background-size:
        22px 22px,
        22px 22px,
        auto,
        auto;
    }

    .memo-header {
      padding-bottom: 0.65rem;
      border-bottom: 2px solid var(--ink);
    }

    .memo-intro {
      margin-top: clamp(1.5rem, 6vh, 3.5rem);
    }

    .memo-kicker {
      margin: 0 0 0.3rem;
      color: var(--blue);
      font-size: clamp(0.9375rem, 2.3vw, 1rem);
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .memo-intro h2 {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(3.7rem, 18vw, 6rem);
      font-weight: 600;
      letter-spacing: -0.08em;
      line-height: 1;
    }

    .memo-intro > p:last-child {
      max-width: 24rem;
      margin: 0.7rem 0 0;
      font-size: clamp(0.9375rem, 2.9vw, 1rem);
      line-height: 1.6;
    }

    .card-memo-list {
      display: grid;
      margin-top: clamp(1.4rem, 5vh, 3rem);
      border-top: 1px solid var(--ink);
    }

    .card-memo-list a {
      display: grid;
      grid-template-columns: 1.7rem 1fr auto;
      gap: 0.55rem;
      align-items: center;
      min-height: clamp(2.7rem, 8vh, 4.1rem);
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      text-decoration: none;
    }

    .card-memo-list a > span {
      color: var(--blue);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.9375rem;
      font-weight: 700;
    }

    .card-memo-list strong {
      font-size: clamp(1rem, 3.25vw, 1.0625rem);
      line-height: 1.35;
    }

    .card-memo-list i {
      color: var(--blue);
      font-style: normal;
    }

    .memo-all-link {
      margin-top: auto;
    }

    .card-navigation {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 10;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 4.25rem;
      gap: 0.6rem;
      padding: 0.45rem clamp(1.15rem, 6vw, 2.2rem);
      border-top: 1px solid var(--line);
      border-radius: 0 0 10px 10px;
      background: #fff;
      backdrop-filter: blur(10px);
      pointer-events: none;
    }

    .business-card[data-page='activity'] .card-navigation {
      border-top-color: var(--blue);
    }

    .business-card[data-page='memo'] .card-navigation {
      background: #f7f8fc;
    }


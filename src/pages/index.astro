---
import BaseLayout from '../layouts/BaseLayout.astro'

const activities = [
  {
    mark: '01',
    title: 'OpenStreetMap / Mapillary',
    description: 'まちを歩き、地域の情報を地図にひらく。',
  },
  {
    mark: '02',
    title: 'オープンデータ・地域情報マップ',
    description: 'データを見つけ、使いやすい形で共有する。',
  },
  {
    mark: '03',
    title: 'Web / 生成AI / オープンソース',
    description: '小さくつくって、試して、育てていく。',
  },
  {
    mark: '04',
    title: 'CoderDojo / プログラミング / 電子工作',
    description: '手を動かす楽しさを、世代をこえて。',
  },
]

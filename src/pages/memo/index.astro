---
import BaseLayout from '../../layouts/BaseLayout.astro'

interface MarkdownModule {
  frontmatter: { date?: string; title?: string }
  rawContent: () => string
}

const modules = import.meta.glob<MarkdownModule>('../../content/memo/*.md', {
  eager: true,
})

const posts = Object.entries(modules)
  .map(([path, post]) => {
    const slug = path.split('/').at(-1)?.replace(/\.md$/, '') ?? ''
    const heading = post.rawContent().match(/^#\s+(.+)$/m)?.[1]

    return {
      slug,
      title: post.frontmatter.title ?? heading ?? slug,
      date: post.frontmatter.date,
    }
  })
  .sort((a, b) => {
    if (a.date && b.date) return b.date.localeCompare(a.date)
    if (a.date) return -1
    if (b.date) return 1
    return a.title.localeCompare(b.title, 'ja')
  })
---

<BaseLayout title="Memo" description="otkzh.github.ioのメモ一覧です。">
  <section class="content">
    <h1>Memo</h1>
    <ul class="memo-list">
      {
        posts.map((post) => (
          <li>
            <a href={`/memo/${post.slug}/`}>{post.title}</a>
            {post.date && <time datetime={post.date}>{post.date}</time>}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .memo-list {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .memo-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid #e3e8ef;
    border-radius: 0.65rem;
  }

  .memo-list a {
    font-weight: 650;
  }

  time {
    color: #64748b;
    font-size: 0.9rem;
  }
</style>

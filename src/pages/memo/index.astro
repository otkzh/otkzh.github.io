---
import MemoLayout from '../../layouts/MemoLayout.astro'

interface MarkdownModule {
  frontmatter: { date?: string | Date; title?: string; tags?: string[] }
  rawContent: () => string
}

const modules = import.meta.glob<MarkdownModule>('../../content/memo/*.md', {
  eager: true,
})

const posts = Object.entries(modules)
  .map(([path, post]) => {
    const slug = path.split('/').at(-1)?.replace(/\.md$/, '') ?? ''
    const heading = post.rawContent().match(/^#\s+(.+)$/m)?.[1]
    const rawDate = post.frontmatter.date
    const date = rawDate
      ? rawDate instanceof Date
        ? rawDate.toISOString().slice(0, 10)
        : String(rawDate).slice(0, 10)
      : undefined

    return {
      slug,
      title: post.frontmatter.title ?? heading ?? slug,
      date,
      tags: post.frontmatter.tags ?? [],
    }
  })
  .sort((a, b) => {
    if (a.date && b.date) return b.date.localeCompare(a.date)
    if (a.date) return -1
    if (b.date) return 1
    return a.title.localeCompare(b.title, 'ja')
  })
---

<MemoLayout
  title="Memo"
  description="地図、データ、Webについての太田一穂のメモ一覧です。"
  kind="index"
>
  <header class="memo-index-hero">
    <div>
      <p>THINK / MAKE / SHARE</p>
      <h1>Memo</h1>
    </div>
    <p>
      地図やデータ、Webのこと。<br
      />考えたことや試したことを、短く書き留めています。
    </p>
  </header>

  <section class="memo-archive" aria-labelledby="archive-title">
    <div class="archive-heading">
      <span>01 / ARCHIVE</span>
      <h2 id="archive-title">すべてのメモ</h2>
    </div>
    <ol class="memo-list">
      {
        posts.map((post, index) => (
          <li>
            <a href={`/memo/${post.slug}/`}>
              <span class="memo-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <small>
                  {post.tags.includes('AI記事')
                    ? 'AI記事 / NOTE'
                    : post.date
                      ? 'DATED NOTE'
                      : 'ARCHIVE NOTE'}
                </small>
                <h3>{post.title}</h3>
                {post.date && <time datetime={post.date}>{post.date}</time>}
              </div>
              <span class="memo-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</MemoLayout>

<style is:global>
  .memo-index-hero {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    min-height: 430px;
    padding: clamp(3rem, 7vw, 6rem);
    background:
      radial-gradient(
        circle at 72% 28%,
        rgba(54, 92, 255, 0.13),
        transparent 17rem
      ),
      #fff;
  }

  .memo-index-hero > div > p {
    margin: 0 0 0.5rem;
    color: var(--blue);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .memo-index-hero h1 {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(5rem, 13vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.09em;
    line-height: 0.82;
  }

  .memo-index-hero > p {
    margin: 0;
    padding-top: 1.2rem;
    border-top: 2px solid var(--blue);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    font-weight: 500;
    line-height: 1.75;
  }

  .memo-archive {
    padding: clamp(2rem, 6vw, 5rem);
    border-top: 1px solid var(--ink);
    background: #f7f8fc;
  }

  .archive-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .archive-heading span {
    color: var(--blue);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .archive-heading h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .memo-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .memo-list li {
    border-top: 1px solid var(--ink);
  }

  .memo-list li:nth-child(odd) {
    border-right: 1px solid var(--ink);
  }

  .memo-list a {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 1.2rem;
    align-items: start;
    min-height: 190px;
    padding: 1.6rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .memo-list a:hover {
    background: var(--blue);
    color: #fff;
  }

  .memo-number,
  .memo-list small,
  .memo-list time {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .memo-number,
  .memo-list small {
    color: var(--blue);
  }

  .memo-list a:hover .memo-number,
  .memo-list a:hover small {
    color: rgba(255, 255, 255, 0.72);
  }

  .memo-list h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    letter-spacing: -0.035em;
    line-height: 1.4;
  }

  .memo-list time {
    display: block;
    margin-top: 0.65rem;
    color: #333;
  }

  .memo-arrow {
    color: var(--blue);
    font-size: 1.2rem;
  }

  .memo-list a:hover .memo-arrow {
    color: #fff;
  }

  @media (min-width: 0) {
    .memo-index-hero {
      flex: 0 0 42%;
      grid-template-columns: 1fr;
      gap: clamp(1rem, 3vh, 2rem);
      min-height: 0;
      padding: clamp(2rem, 6vh, 3.5rem) 1.35rem clamp(1.3rem, 3vh, 2rem);
    }

    .memo-index-hero h1 {
      font-size: clamp(4.5rem, 23vw, 7rem);
    }

    .memo-archive {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 2rem 1.35rem;
      scrollbar-width: none;
    }

    .memo-archive::-webkit-scrollbar {
      display: none;
    }

    .memo-list {
      grid-template-columns: 1fr;
    }

    .memo-list li:nth-child(odd) {
      border-right: 0;
    }

    .memo-list a {
      min-height: 126px;
      padding: 1.25rem 0;
    }
  }

  @media (max-width: 720px) and (max-height: 650px) {
    .memo-index-hero {
      flex-basis: 38%;
      gap: 0.7rem;
      padding-block: 1.5rem 1rem;
    }

    .memo-index-hero h1 {
      font-size: clamp(4rem, 20vw, 5.6rem);
    }

    .memo-index-hero > p {
      padding-top: 0.7rem;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .memo-archive {
      padding-block: 1.3rem;
    }

    .archive-heading {
      margin-bottom: 1.1rem;
    }

    .memo-list a {
      min-height: 108px;
    }
  }

  @media (orientation: landscape) and (max-height: 560px),
    (min-width: 721px) {
    body.memo-index .memo-page-shell {
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
    }

    body.memo-index .memo-masthead,
    body.memo-index .memo-footer {
      grid-column: 1 / -1;
    }

    .memo-index-hero {
      grid-column: 1;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(1rem, 5vh, 2rem);
      min-height: 0;
      padding: clamp(1.2rem, 5vh, 2rem) clamp(1.5rem, 4vw, 3rem);
      border-right: 1px solid var(--ink);
    }

    .memo-index-hero h1 {
      font-family: 'Shippori Mincho', serif;
      font-size: clamp(3.8rem, 9vw, 6.2rem);
      font-weight: 600;
      letter-spacing: -0.07em;
    }

    .memo-index-hero > p {
      padding-top: 0.75rem;
      font-size: clamp(0.78rem, 1.5vw, 0.9rem);
      line-height: 1.6;
    }

    .memo-archive {
      grid-column: 2;
      grid-row: 2;
      min-height: 0;
      padding: clamp(1rem, 4vh, 1.7rem) clamp(1.2rem, 3vw, 2rem);
      overflow-y: auto;
    }

    .archive-heading {
      margin-bottom: 0.8rem;
    }

    .archive-heading h2 {
      font-family: 'Shippori Mincho', serif;
      font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    }

    .memo-list {
      grid-template-columns: 1fr;
    }

    .memo-list li:nth-child(odd) {
      border-right: 0;
    }

    .memo-list a {
      grid-template-columns: 1.8rem 1fr auto;
      min-height: clamp(4.1rem, 17vh, 5.3rem);
      padding: 0.7rem 0;
    }

    .memo-list h3 {
      margin-top: 0.3rem;
      font-family: 'Shippori Mincho', serif;
      font-size: clamp(0.88rem, 1.8vw, 1.08rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .memo-list a {
      transition: none;
    }
  }
</style>

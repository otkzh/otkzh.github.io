---
import NoteLayout from '../../layouts/NoteLayout.astro'
import { notes, formatNoteDate } from '../../lib/notes'
---

<NoteLayout title="note" description="地図やWebのこと、試したこと。このサイトをどう変えたいかも残していく、太田一穂のnoteです。">
  <header class="note-index-hero">
    <p class="note-kicker">THINK / MAKE / SHARE</p>
    <h1>note</h1>
    <p>考えたこと、試したこと。<br />このサイトをどう変えたいかも、少しずつ残していきます。</p>
  </header>
  <section class="note-archive" aria-labelledby="archive-title">
    <div class="archive-heading">
      <h2 id="archive-title">記事一覧</h2>
      <span>新しい順 · {notes.length}件</span>
    </div>
    <ol class="note-list">
      {notes.map((note) => (
        <li>
          <a href={`/note/${note.slug}/`}>
            <time datetime={note.date}>{formatNoteDate(note.date)}</time>
            <div>
              <h3>{note.title}</h3>
              <p>{note.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</NoteLayout>

<style>
  .note-index-hero { padding: clamp(2rem, 5vw, 3.5rem) clamp(1.2rem, 4vw, 3rem); }
  .note-kicker { margin: 0; color: #2447af; font: 700 0.875rem 'Space Grotesk', sans-serif; letter-spacing: 0.12em; }
  h1 { margin: 0.2rem 0 1rem; font: 600 clamp(3rem, 8vw, 5rem)/1.1 'Space Grotesk', sans-serif; letter-spacing: -0.06em; }
  .note-index-hero > p:last-child { margin: 0; font-size: 1rem; line-height: 1.8; }
  .note-archive { padding: 0 clamp(1.2rem, 4vw, 3rem) 2rem; }
  .archive-heading { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; align-items: baseline; padding-bottom: 0.8rem; }
  .archive-heading h2 { margin: 0; font-size: 1.25rem; }
  .archive-heading span { font-size: 0.875rem; color: #444; }
  .note-list { margin: 0; padding: 0; list-style: none; }
  .note-list li { border-top: 1px solid var(--line); }
  .note-list a { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; padding: 1.5rem 0; color: var(--ink); text-decoration: none; }
  .note-list time { padding-top: 0.2rem; }
  .note-list h3 { margin: 0 0 0.55rem; font-size: clamp(1.15rem, 2.3vw, 1.5rem); line-height: 1.5; overflow-wrap: anywhere; }
  .note-list p { margin: 0; color: #333; font-size: 0.95rem; line-height: 1.8; }
  .note-list a:hover h3 { color: #2447af; text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 700px) {
    .note-list a { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
